# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Seguridad (16/11/2026): que no se suban claves, volcados ni archivos subidos
# Variables de entorno: el .env* de arriba también tapaba el ejemplo, que sí se versiona
!.env.example
# Volcados de base: .sql sueltos en la raíz o con dump/backup en el nombre, y comprimidos
/*.sql
*dump*.sql
*backup*.sql
*.sql.gz
*.dump
# Llaves y certificados (*.pem ya estaba arriba)
*.key
*.p12
*.pfx
# Logs
*.log
